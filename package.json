{
  "name": "pi-coms",
  "private": true,
  "type": "module",
  "description": "Peer-to-peer communication for Pi Coding Agent instances, with multi-account AWS deployment",
  "version": "0.1.0",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "extensions",
    "scripts/coms-net-server.ts",
    "README.md",
    "docs"
  ],
  "pi": {
    "extensions": [
      "./extensions/coms-net.ts"
    ]
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "biome:check": "biome check .",
    "biome:check:write": "biome check --write .",
    "yaml:check": "yamllint -d relaxed .github/"
  },
  "dependencies": {
    "@aws-sdk/client-acm": "^3.1123.0",
    "@aws-sdk/client-cloudtrail": "^3.1123.0",
    "@aws-sdk/client-cloudwatch": "^3.1121.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1121.0",
    "@aws-sdk/client-cost-explorer": "^3.1121.0",
    "@aws-sdk/client-ec2": "^3.1121.0",
    "@aws-sdk/client-lambda": "^3.1121.0",
    "@aws-sdk/client-rds": "^3.1121.0",
    "@aws-sdk/client-sts": "^3.1123.0",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
