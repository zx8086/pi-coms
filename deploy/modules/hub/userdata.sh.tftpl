#!/usr/bin/env bash
# deploy/modules/hub/userdata.sh.tftpl
#
# Boots the coms-net hub: install Bun, clone the repo, fetch the token,
# run scripts/coms-net-server.ts under systemd. The hub needs no Pi, no
# Herdr, and no provider keys, so it does not use the shared agent
# bootstrap -- this small script is its whole install.
set -euo pipefail

exec > >(tee /var/log/coms-hub-bootstrap.log) 2>&1
echo "=== coms-hub bootstrap $(date -Is) ==="

dnf install -y tar gzip unzip

HUB_USER=comshub
HUB_HOME="/home/$HUB_USER"
id -u "$HUB_USER" &>/dev/null || useradd -m -s /bin/bash "$HUB_USER"

sudo -u "$HUB_USER" -H bash -euo pipefail -c '
  cd "$HOME"
  command -v "$HOME/.bun/bin/bun" >/dev/null || curl -fsSL https://bun.sh/install | bash
'

if [ -n '${bundle_s3_uri}' ]; then
  # AWS-native path: fetch the fleet bundle instead of cloning GitHub.
  rm -rf "$HUB_HOME/pi-coms.new"
  mkdir -p "$HUB_HOME/pi-coms.new"
  aws s3 cp '${bundle_s3_uri}/bundle.tar.gz' /tmp/hub-bundle.tar.gz --region '${region}'
  tar -xzf /tmp/hub-bundle.tar.gz -C "$HUB_HOME/pi-coms.new"
  rm -f /tmp/hub-bundle.tar.gz
  # Record the bundle version the same way the agent hosts do; pi-coms-update
  # compares it against the S3 version object.
  aws s3 cp '${bundle_s3_uri}/version' "$HUB_HOME/pi-coms.new/.bundle-version" --region '${region}' 2>/dev/null \
    || echo unknown > "$HUB_HOME/pi-coms.new/.bundle-version"
  rm -rf "$HUB_HOME/pi-coms"
  mv "$HUB_HOME/pi-coms.new" "$HUB_HOME/pi-coms"
  chown -R "$HUB_USER:$HUB_USER" "$HUB_HOME/pi-coms"

  # Convergence script. The fleet State Manager association targets
  # tag:Project=pi-coms-net, which this host carries, and runs
  # /usr/local/bin/pi-coms-update every 30 minutes; without this file the
  # hub silently never picked up a fleet publish. Same contract as the agent
  # hosts: compare versions, then re-run the idempotent userdata, which swaps
  # the bundle and restarts coms-hub. Root-owned; SSM runs commands as root.
  cat > /usr/local/bin/pi-coms-update <<UPDATE
#!/usr/bin/env bash
set -euo pipefail
CURRENT="\$(cat '$HUB_HOME/pi-coms/.bundle-version' 2>/dev/null || echo none)"
LATEST="\$(aws s3 cp '${bundle_s3_uri}/version' - --region '${region}' 2>/dev/null || echo unknown)"
if [ "\$CURRENT" = "\$LATEST" ] && [ "\$LATEST" != "unknown" ]; then
  echo "pi-coms hub up to date (\$CURRENT)"
  exit 0
fi
echo "updating pi-coms hub: \$CURRENT -> \$LATEST"
bash /var/lib/cloud/instance/user-data.txt
UPDATE
  chmod 755 /usr/local/bin/pi-coms-update
elif [ -d "$HUB_HOME/pi-coms/.git" ]; then
  dnf install -y git
  sudo -u "$HUB_USER" -H git -C "$HUB_HOME/pi-coms" pull --ff-only
else
  dnf install -y git
  sudo -u "$HUB_USER" -H git clone --depth 1 '${repo_url}' "$HUB_HOME/pi-coms"
fi

TOKEN="$(aws ssm get-parameter \
  --name '${token_param_name}' --region '${region}' \
  --with-decryption --query Parameter.Value --output text)"
[ -n "$TOKEN" ] || { echo "hub token is empty" >&2; exit 1; }

ENV_FILE="$HUB_HOME/.hub-env"
{
  echo "export PI_COMS_NET_HOST=0.0.0.0"
  echo "export PI_COMS_NET_PORT=${port}"
  echo "export PI_COMS_NET_AUTH_TOKEN='$TOKEN'"
  if [ -n '${auth_ssm_path}' ]; then
    # Directory mode: per-principal tokens polled from Parameter Store; the
    # shared token above stays valid as the root/migration principal.
    echo "export PI_COMS_NET_AUTH_SSM_PATH='${auth_ssm_path}'"
    echo "export AWS_REGION='${region}'"
  fi
} > "$ENV_FILE"
chown "$HUB_USER:$HUB_USER" "$ENV_FILE"
chmod 600 "$ENV_FILE"

cat > /etc/systemd/system/coms-hub.service <<UNIT
[Unit]
Description=coms-net hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=$HUB_USER
WorkingDirectory=$HUB_HOME/pi-coms
Environment=HOME=$HUB_HOME
ExecStart=/bin/bash -c 'source \$HOME/.hub-env && exec \$HOME/.bun/bin/bun scripts/coms-net-server.ts'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable coms-hub.service
systemctl restart coms-hub.service

echo "=== coms-hub bootstrap complete $(date -Is) ==="
