#!/usr/bin/env bash
# deploy/modules/agent/userdata.sh.tftpl
#
# Thin shim: fetch the repo, set the environment contract, and hand off to the
# shared bootstrap (deploy/bootstrap/agent-bootstrap.sh). All real logic lives
# there so AWS and VPS hosts run identical code.
set -euo pipefail

exec > >(tee /var/log/pi-agent-bootstrap.log) 2>&1
echo "=== pi agent userdata shim $(date -Is) ==="

rm -rf /opt/pi-bootstrap
if [ -n '${bundle_s3_uri}' ]; then
  # AWS-native path: fetch the fleet bundle instead of cloning GitHub.
  mkdir -p /opt/pi-bootstrap
  aws s3 cp '${bundle_s3_uri}/bundle.tar.gz' /tmp/pi-bootstrap.tar.gz --region '${region}'
  tar -xzf /tmp/pi-bootstrap.tar.gz -C /opt/pi-bootstrap
  rm -f /tmp/pi-bootstrap.tar.gz
else
  dnf install -y git
  git clone --depth 1 '${repo_url}' /opt/pi-bootstrap
fi

export SECRETS_SOURCE=aws
export COMS_TOKEN_PARAM='${token_param_name}'
export PROVIDER_KEYS_PARAM='${keys_param_name}'
export BUNDLE_S3_URI='${bundle_s3_uri}'
export AWS_REGION='${region}'
export AWS_ACCOUNT_ID='${account_id}'
export PI_COMS_NET_SERVER_URL='${hub_url}'
export AGENT_NAME='${agent_name}'
export AGENT_PURPOSE='${agent_purpose}'
export PI_MODEL='${pi_model}'
export PI_PROVIDER='${pi_provider}'
export COMS_PROJECT='${coms_project}'
export SSH_PUBLIC_KEY='${ssh_public_key}'
export REPO_URL='${repo_url}'

bash /opt/pi-bootstrap/deploy/bootstrap/agent-bootstrap.sh
